generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id      Int      @id @default(autoincrement())
  name    String
  code    String   @unique
  iphones Iphone[]
}

model Iphone {
  id                Int      @id @default(autoincrement())
  model             String
  capacity          String
  color             String?  // New color field
  imei              String?
  batteryStatus     String
  batteryPercentage Int?
  price             Float
  discountType      String   @default("N/A")
  observations      String?
  branchId          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id])
}

model CatalogPrice {
  id            Int      @id @default(autoincrement())
  model         String
  capacity      String
  color         String   @default("") // Empty string = all colors
  price         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([model, capacity, color])
}
